# Copy to .env or set in your shell before starting uvicorn.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tech_debt_agent

# Groq powers the AI chatbot. Code generation tries Gemini keys in order,
# then falls back to this OpenAI-compatible provider when configured.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
GEMINI_MODEL_1=gemini-3.1-flash-lite
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_MODEL_2=gemini-3.1-flash-lite
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_MODEL_3=gemini-3.1-flash-lite
GEMINI_API_KEY_3=your_gemini_api_key_3_here
GEMINI_MODEL_4=gemini-3.1-flash-lite
GEMINI_API_KEY_4=your_gemini_api_key_4_here
GEMINI_MODEL_5=gemini-3.1-flash-lite
GEMINI_API_KEY_5=your_gemini_api_key_5_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
CODE_GENERATION_PROVIDER=default
AI_TIMEOUT=30
