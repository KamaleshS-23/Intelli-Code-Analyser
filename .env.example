# Copy to .env or set in your shell before starting uvicorn.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tech_debt_agent

# AI assistant configuration
AI_PROVIDER=auto
AI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_1=gemini-3.1-flash-lite
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_MODEL_2=gemini-3.1-flash-lite
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=30
